# 运行产物与本地环境（不进版本库）
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 运行日志与输出
logs/
out/

# 覆盖率数据（coverage.py；scripts/run_tests.py --coverage 与 CI 会生成，不入库）
.coverage
.coverage.*
htmlcov/

# PyInstaller 打包产物（dist/ 是要发给别人的 exe；build/ 与 .spec 是中间产物）
dist/
build/
*.spec
# 调试打包用的临时目录（scripts/build_exe.py 手工加 --workpath/--distpath 时生成）
dist_dbg/
build_dbg/

# 用户自己的配置（设备名、语言偏好等因机器而异，不入库）
# 入库的是 config.example.yaml 模板；首次运行会自动复制生成 config.yaml
config.yaml
# 配置写坏时的自动备份（见 vlt/config.py 的恢复逻辑）
config.yaml.broken
config.yaml.bak.*
config.local.yaml

# 编辑器
.vscode/
.idea/
*.swp

# 运行时缓存：源码运行时 `paths.app_dir()` 就是仓库根，这些文件会长在这儿
# （`pagefile-hint.json` 由 win_capture 写、`key_cache.json` 是冻结版的候选落点）。
# 它们只对**本机**有意义（MFT 记录号 / 一把进程级密钥），绝不能进版本库。
pagefile-hint.json
key_cache.json
vlt_keyd_dump_*.json
